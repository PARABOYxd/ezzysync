# ==========================================
# SERVER
# ==========================================
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==========================================
# JWT
# ==========================================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
OTP_SECRET=replace_with_another_long_random_string

# ==========================================
# POSTGRES DATABASE
# Use a single connection string (works out of the box on Render/Railway/Neon/Supabase),
# or set PGHOST/PGUSER/etc individually if you prefer.
# ==========================================
DATABASE_URL=postgresql://username:password@localhost:5432/whatsappBusinessCRM
# Set to true when connecting to a hosted Postgres that requires SSL (Render, Railway, Neon, Supabase, etc.)
PGSSL=false

# ==========================================
# EMAIL (Resend HTTPS API) - required, this is the default sender
# Get an API key at resend.com and verify your sending domain.
# ==========================================
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=EzzySync <noreply@ezzysync.com>

# ==========================================
# EMAIL (SMTP) - optional, leave blank to always use Resend above.
# Only fill this in if you're on a Render plan (or host) that allows
# outbound SMTP - Render's free tier blocks ports 25/465/587, which
# makes an SMTP transport hang for minutes instead of failing. When
# SMTP_HOST is set, it's tried first (with an 8s timeout) and falls
# back to Resend automatically if it fails.
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password

# ==========================================
# WHATSAPP CLOUD API (Meta)
# ==========================================
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temp_access_token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ==========================================
# GOOGLE GEMINI AI API KEY
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# FILE STORAGE — Cloudflare R2
# ==========================================
# Without all of these, uploads fall back to the local uploads/ folder. That
# folder is wiped on every deploy, so customer photos and PDFs disappear, and
# a second server instance cannot see the first one's files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ==========================================
# ENCRYPTION
# ==========================================
# 64 hex characters. Encrypts stored Google and Instagram credentials.
# The server will not start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ==========================================
# PAYMENTS — Razorpay
# ==========================================
# Payments silently run on mock keys if these are missing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# GOOGLE (sign-in + Gmail)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# ==========================================
# FEATURE FLAGS
# ==========================================
# Instagram Direct uses an unofficial client that Instagram actively rate-limits,
# so it is off unless explicitly switched on. The other two default to on.
ENABLE_INSTAGRAM=false
ENABLE_WHATSAPP_WEB=true
ENABLE_AI_AUTOPILOT=true

# ==========================================
# AI BEHAVIOUR
# ==========================================
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
# How old a queued message may be and still get an automatic reply, in seconds.
# When the session has been offline, WhatsApp delivers the backlog on reconnect;
# anything older than this is recorded but left for a person, so the bot does
# not answer a pile of stale messages all at once. Default 900 (15 minutes).
AI_REPLY_MAX_AGE_SECONDS=900

# ==========================================
# INSTAGRAM DIRECT (only used when ENABLE_INSTAGRAM=true)
# ==========================================
# Polling any faster than this gets the account rate-limited (error 467).
IG_POLL_INTERVAL_MS=60000
IG_FIRST_POLL_DELAY_MS=45000
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ==========================================
# MISC
# ==========================================
BACKEND_URL=http://localhost:5001
DEFAULT_TRIAL_DAYS=30
UNSPLASH_ACCESS_KEY=
LOG_LEVEL=info
