# ==========================================
# SERVER
# ==========================================
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==========================================
# JWT
# ==========================================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_SECRET=replace_with_another_long_random_string

# ==========================================
# POSTGRES DATABASE
# Use a single connection string (works out of the box on Render/Railway/Neon/Supabase),
# or set PGHOST/PGUSER/etc individually if you prefer.
# ==========================================
DATABASE_URL=postgresql://username:password@localhost:5432/whatsappBusinessCRM
# Set to true when connecting to a hosted Postgres that requires SSL (Render, Railway, Neon, Supabase, etc.)
PGSSL=false

# ==========================================
# EMAIL (Resend HTTPS API) - required, this is the default sender
# Get an API key at resend.com and verify your sending domain.
# ==========================================
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=EzzySync <noreply@ezzysync.com>

# ==========================================
# EMAIL (SMTP) - optional, leave blank to always use Resend above.
# Only fill this in if you're on a Render plan (or host) that allows
# outbound SMTP - Render's free tier blocks ports 25/465/587, which
# makes an SMTP transport hang for minutes instead of failing. When
# SMTP_HOST is set, it's tried first (with an 8s timeout) and falls
# back to Resend automatically if it fails.
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password

# ==========================================
# WHATSAPP CLOUD API (Meta)
# ==========================================
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temp_access_token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
