{
  "services": {
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/app/(.*)", "destination": "https://ezzysync-frontend.vercel.app/$1" },
    { "source": "/app", "destination": "https://ezzysync-frontend.vercel.app/" },
    { "source": "/(.*)", "destination": { "service": "landing" } }
  ]
}
