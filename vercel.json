{
  "services": {
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/app/(.*)", "destination": { "service": "frontend" } },
    { "source": "/app", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "landing" } }
  ]
}
