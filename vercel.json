{
  "services": {
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    }
  },
  "headers": [
    {
      "source": "/app/((?!login|register).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "https://ezzysync-frontend.vercel.app/$1"
    },
    {
      "source": "/app",
      "destination": "https://ezzysync-frontend.vercel.app/"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
