{
  "services": {
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "frontend/dist",
      "routes": [
        {
          "src": "/app/(.*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/$1" }
          ]
        },
        {
          "src": "/app",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/app/(.*)", "destination": { "service": "frontend" } },
    { "source": "/app", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "landing" } }
  ]
}
