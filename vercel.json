{
  "services": {
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/app/(.*)", "destination": "https://REPLACE_WITH_FRONTEND_PROJECT_URL/$1" },
    { "source": "/app", "destination": "https://REPLACE_WITH_FRONTEND_PROJECT_URL/" },
    { "source": "/(.*)", "destination": { "service": "landing" } }
  ]
}
