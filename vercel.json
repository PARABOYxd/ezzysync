{
  "services": {
    "landing": {
      "root": "landing",
      "framework": "nextjs"
    },
    "frontend": {
      "root": "frontend",
      "buildCommand": "vite build && mkdir -p .vercel/output/static && cp -r dist/. .vercel/output/static/",
      "outputDirectory": ".vercel/output",
      "routes": [
        {
          "src": "/app/(.*)",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/$1" }
          ]
        },
        {
          "src": "/app",
          "transforms": [
            { "type": "request.path", "op": "set", "args": "/" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/app/(.*)", "destination": { "service": "frontend" } },
    { "source": "/app", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "landing" } }
  ]
}
